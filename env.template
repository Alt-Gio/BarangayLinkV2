# =====================================================
# BarangayLink v2 - Environment Configuration
# =====================================================
# 
# HOW TO USE:
# 1. Copy this file to .env.local
# 2. Fill in your API keys below
# 3. Restart the dev server
#
# Copy command:  cp .env.template .env.local
# =====================================================


# -----------------------------------------------------
# REQUIRED - App won't work without these
# -----------------------------------------------------

# Convex Database
# Get from: https://dashboard.convex.dev → Your Project → Settings
NEXT_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud
CONVEX_DEPLOYMENT=dev:your-project-name

# Clerk Authentication
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Webhook (for user sync)
# Get from: Clerk Dashboard → Webhooks → Create Endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------
# OPTIONAL - App works without these but with limited features
# -----------------------------------------------------

# Mapbox (for maps and location features)
# Get from: https://account.mapbox.com/access-tokens/
# Free tier: 50,000 map loads/month
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (for sending emails)
# Get from: https://resend.com/api-keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Liveblocks (for real-time collaboration)
# Get from: https://liveblocks.io/dashboard → API Keys
# Free tier: 300 monthly active users
LIVEBLOCKS_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------
# APP CONFIGURATION - Change if needed
# -----------------------------------------------------

# Your app URL (change for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/complete-profile


# -----------------------------------------------------
# FEATURE FLAGS - Set to false to disable features
# -----------------------------------------------------

NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_REAL_TIME_CHAT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_FILE_UPLOAD=true


# -----------------------------------------------------
# FILE UPLOAD LIMITS
# -----------------------------------------------------

# Max file size in bytes (default: 10MB)
NEXT_PUBLIC_MAX_FILE_SIZE=10485760

# Allowed file types
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/*,application/pdf,text/*
